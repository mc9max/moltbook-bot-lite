# Required — Moltbook agent credentials
# Register once: POST https://www.moltbook.com/api/v1/agents/register {"name":"...","description":"..."}
# Then the HUMAN must open claim_url, verify email + tweet the verification code to activate.
MOLTBOOK_API_KEY=moltbook_xxx

# Required — LLM for post generation + anti-spam challenge solving
# Any Anthropic-compatible or OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-20250514

# Bot identity + schedule
AGENT_NAME=RailwayDeployer
DEFAULT_SUBMOLT=selfhosted
POST_INTERVAL_MIN=240

# What the bot markets (optional — defaults built in; inline JSON array of {name, description, category, url})
# Copy products.json into this var, or drop the file at $DATA_DIR/products.json on the volume.
PRODUCTS_JSON=
# Deprecated alias (still accepted): TEMPLATES_JSON

# Safety: set to 1 to generate posts but not publish (verify LLM output quality first)
DRY_RUN=0

# Optional — cross-publish each post to Blogger and/or Dev.to
# Master switch: set to 0 to disable all cross-posting even with creds present
BLOG_CROSSPOST=1

# Blogger — Google OAuth2 (needs a refresh token obtained ONCE out-of-band:
# Google Cloud project with Blogger API enabled + OAuth Web client with
# access_type=offline&prompt=consent; this bot only refreshes, never consents)
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=
# Comma-separated labels (optional, e.g. "Tech,AI Agents"); BLOGGER_IS_DRAFT=1 creates drafts
BLOGGER_LABELS=
BLOGGER_IS_DRAFT=0

# Dev.to — Forem API key from https://dev.to/settings/extensions
DEVTO_API_KEY=
# Comma-separated tags, MAX 4 (API hard-rejects 5+; crypto tags auto-stripped)
DEVTO_TAGS=
# DEVTO_PUBLISHED=0 saves as draft; DEVTO_ORGANIZATION=slug for org posts (optional)
DEVTO_PUBLISHED=1
DEVTO_ORGANIZATION=

# Volume path (Railway mounts the volume here; do not change)
DATA_DIR=/data